<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="DatabaseServer" value="DESKTOP-PL78B86"/>
    <add key="NotificationServer" value="localhost"/>
    <add key="DatabaseName" value="AlborzPro"/>
    <add key="SysVersion" value="5.1.0.0"/>
    <add key="WadVersion" value="5.1.0.0"/>
    <add key="PkgVersion" value="{PkgVersion}"/>
    <add key="BPMSHome" value="true"/>
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.7.2" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Net.Http.WebRequest, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Net.Http, Version=4.2.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
      </assemblies>
    </compilation>
    <httpCookies httpOnlyCookies="true"/>
    <httpRuntime maxRequestLength="2097151" requestValidationMode="2.0"/>
    <pages controlRenderingCompatibilityVersion="4.0" validateRequest="false"/>
    <customErrors mode="Off" defaultRedirect="Error.aspx?Id=aMd19fl4C"/>
    <webServices>
      <protocols>
        <add name="HttpGet"/>
        <add name="HttpPost"/>
      </protocols>
    </webServices>
  </system.web>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="500000000"/>
      </webServices>
    </scripting>
  </system.web.extensions>
  <system.webServer>
    <httpProtocol allowKeepAlive="false">
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-UA-Compatible" value="IE=8, Chrome=1"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
        <add name="Referrer-Policy" value="no-referrer"/>
        <add name="X-XSS-Protection" value="mode=block"/>
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false"/>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648" maxUrl="40960" maxQueryString="32768"/>
        <verbs>
          <remove verb="OPTIONS"/>
          <add verb="OPTIONS" allowed="false"/>
        </verbs>
      </requestFiltering>
    </security>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:30:00"/>
    </staticContent>
    <defaultDocument>
      <files>
        <clear/>
        <add value="default.aspx"/>
        <add value="Default.htm"/>
        <add value="Default.asp"/>
        <add value="index.htm"/>
        <add value="index.html"/>
        <add value="iisstart.htm"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>