                            insertUserTrackCommand.Parameters.Add("@Description", SqlDbType.NVarChar).Value = description;
                            insertUserTrackCommand.Parameters.Add("@TrackStatus", SqlDbType.NVarChar).Value = trackStatus;
                            insertUserTrackCommand.Parameters.Add("@UserID", SqlDbType.Int).Value = SessionProvider.UserID;
                            insertUserTrackCommand.Parameters.Add("@Index", SqlDbType.Int).Value = trackCountUsed + 1;

                            totalRecordsAdded += insertUserTrackCommand.ExecuteNonQuery();
                        }
                        validIndexCounter++;
                    }
                    string lockManualTrackQuery = @"UPDATE Hrs_ManualTracks 
                                              SET IsLock = 1 
                                              WHERE Date = @Date AND EmployeeNumber = @EmployeeNumber";
                    using (var lockCommand = new SqlCommand(lockManualTrackQuery, conn, transaction))
                    {
                        lockCommand.Parameters.Add("@EmployeeNumber", SqlDbType.Int).Value = employeeNumber;
                        lockCommand.Parameters.Add("@Date", SqlDbType.Date).Value = date;

                        totalRecordsAdded += lockCommand.ExecuteNonQuery();
                    }
                    if (reduceCountIssue)
                    {
