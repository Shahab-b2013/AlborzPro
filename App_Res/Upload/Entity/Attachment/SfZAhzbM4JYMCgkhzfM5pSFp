    [WebMethod(EnableSession = true)]
    public string SaveCalendarDays(List<CalendarEntry> calendarEntries)
    {
        if (!UserIsMaster())
            return "access error";

        if (calendarEntries == null || calendarEntries.Count == 0)
            return "No entries to save.";

        using (SqlConnection conn = SqlDataProvider.DbConnection)
        {
            conn.Open();

            // Delete all records for the given WorkingCalendarID, Year, and Month before inserting
            var firstEntry = calendarEntries.First();
            DeleteAllCalendarDays(conn, firstEntry.ObjKey);

            foreach (var entry in calendarEntries)
            {
                string query = @"
                INSERT INTO Hrs_CalendarDays ( WorkingCalendarID, Date, DayOfWeek, Label, DayOfMonth, MonthOfYear, MonthLabel, Year,
                    StartWorkTime, OffWorkTime, IsHoliday, IsPubHoliday, LangCode, Enabled, Version, Description)
                VALUES (@ObjKey, @Date, @DayOfWeek, '', @DayOfMonth, @MonthOfYear, @MonthLabel,
                        @Year, 0, 0, 1, 0, '', 1, 'custom', '')";

                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@ObjKey", entry.ObjKey);
                    cmd.Parameters.AddWithValue("@Date", entry.Date);
                    cmd.Parameters.AddWithValue("@DayOfWeek", entry.DayOfWeek);
                    cmd.Parameters.AddWithValue("@DayOfMonth", entry.DayOfMonth);
                    cmd.Parameters.AddWithValue("@MonthOfYear", entry.MonthOfYear);
                    cmd.Parameters.AddWithValue("@MonthLabel", entry.MonthLabel);
                    cmd.Parameters.AddWithValue("@Year", entry.Year);

                    cmd.ExecuteNonQuery();
                }
            }

            return "Success";
        }
    }

