    [WebMethod(EnableSession = true)]
    public string GetTaskCount()
    {
        int sessionValidate = SessionProvider.ValidateSession("CurrentSession");

        if (sessionValidate == 2 || sessionValidate == 3)
        {
            int logID = LogProvider.LogException(10010, "Session is invalid.", "ActivityID is GetTaskCount");

            return "0";
        }

        int sumTask = 0;
        int userId = SessionProvider.UserID;

        string query1 = @"
         SELECT COUNT(TaskID)
         FROM Sys_Pex_Tasks
         WHERE TaskStatusID = 1 
           AND dbo.HasAccess3(AssigneeUID, AssigneeTID, AssigneePID, @UserId) = 1
           AND _IsDeleted = 0";

        string query2 = @"
    SELECT COUNT(*)
    FROM Hrs_UserTracks
    INNER JOIN Hrs_Employees ON Hrs_UserTracks.EmployeeNumber = Hrs_Employees.EmployeeNumber
    WHERE ((Hrs_UserTracks.TrackStatus = N'RequestAllowed') 
           AND (dbo.GetEmployeeManager(Hrs_Employees.EmployeeID) = @SessionUserID) 
           OR (Hrs_UserTracks.TrackStatus = N'RequestAllowed') 
           AND (dbo.GetEmployeeDeputy(Hrs_Employees.EmployeeID) = @SessionUserID)
           OR (Hrs_UserTracks.TrackStatus = N'RequestAllowed')
AND (dbo.EmployeeIsDeputy(Hrs_Employees.EmployeeID) = 1 AND dbo.IsCeoUser(@SessionUserID)=1)) 
      AND Hrs_Employees.EmployeeID <> @SessionUserID 
      AND Hrs_UserTracks._IsDeleted = 0";

        string query3 = @"
    SELECT COUNT(*)
    FROM Hrs_UserTracks
    INNER JOIN Hrs_Employees ON Hrs_UserTracks.EmployeeNumber = Hrs_Employees.EmployeeNumber
    WHERE ((Hrs_UserTracks.TrackStatus LIKE N'Request%Work') 
           AND (dbo.GetEmployeeManager(Hrs_Employees.EmployeeID) = @SessionUserID) 
           OR (Hrs_UserTracks.TrackStatus LIKE N'Request%Work') 
           AND (dbo.GetEmployeeDeputy(Hrs_Employees.EmployeeID) = @SessionUserID)
           OR (Hrs_UserTracks.TrackStatus LIKE N'Request%Work') 
          AND (dbo.EmployeeIsDeputy(Hrs_Employees.EmployeeID) = 1 AND dbo.IsCeoUser(@SessionUserID)=1)) 
      AND Hrs_Employees.EmployeeID <> @SessionUserID 
      AND Hrs_UserTracks._IsDeleted = 0";

        try
        {
            using (var connection = SqlDataProvider.DbConnection)
            using (var command = new SqlCommand(query1, connection))
            {
                // Add parameter to prevent SQL injection.
                command.Parameters.AddWithValue("@UserId", userId);
                connection.Open();

                var result = command.ExecuteScalar();
                if (result != null && result != DBNull.Value)
                {
                    sumTask += Convert.ToInt32(result);
                }
            }

            // Execute query2
            using (var connection = SqlDataProvider.DbConnection)
            using (var command = new SqlCommand(query2, connection))
            {
                command.Parameters.AddWithValue("@SessionUserID", userId);
                connection.Open();

                var result2 = command.ExecuteScalar();
                if (result2 != null && result2 != DBNull.Value)
                {
                    sumTask += Convert.ToInt32(result2);
                }
            }

            // Execute query3
            using (var connection = SqlDataProvider.DbConnection)
            using (var command = new SqlCommand(query3, connection))
            {
                command.Parameters.AddWithValue("@SessionUserID", userId);
                connection.Open();

                var result3 = command.ExecuteScalar();
                if (result3 != null && result3 != DBNull.Value)
                {
                    sumTask += Convert.ToInt32(result3);
                }
            }
        }
        catch (Exception ex)
        {
            LogProvider.LogExceptionInFile(10050, ex.Message);
            return LogProvider.PrepareLogResultStr(ex.Message, 10050);
        }

        return sumTask.ToString();
    }

