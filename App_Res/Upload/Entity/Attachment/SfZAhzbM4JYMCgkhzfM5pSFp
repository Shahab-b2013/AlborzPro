    private string FormatMinutesToTime(object value)
    {
        if (value == DBNull.Value)
        {
            return "";
        }

        // Try parsing the value into an integer representing total minutes
        int totalMinutes;
        if (int.TryParse(value.ToString(), out totalMinutes))
        {
            // Calculate hours and minutes
            int hours = totalMinutes / 60;    // Get the total hours
            int minutes = totalMinutes % 60;  // Get the remaining minutes

            // Format it as HHH:MM (with hours possibly more than 24)
            return string.Format("{0:D3}:{1:D2}", hours, minutes);
        }

        return "";
    }

