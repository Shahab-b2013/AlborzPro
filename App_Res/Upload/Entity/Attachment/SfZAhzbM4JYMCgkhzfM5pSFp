                            updateMonthlyCommand.Parameters.AddWithValue("@Year", year);

                            totalRecordsAdded += updateMonthlyCommand.ExecuteNonQuery();
                        }
                    }

                    transaction.Commit();
                    return "{totalRecordsAdded} record(s) added successfully.";
                }
                catch (Exception ex)
                {
                    transaction.Rollback();
                    return "Failed to add records: " + ex.Message;
                }
            }
        }
    }

