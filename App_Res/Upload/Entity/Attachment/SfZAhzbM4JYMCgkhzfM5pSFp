      SELECT 
      calendarDays.IsHoliday,
      userTracks.UserTrackID,
      userTracks.EmployeeNumber,
      userTracks.Time1,
      userTracks.Time2,
      workingProfiles.WorkingProfileID,
      userTracks.TrackType
     FROM Hrs_UserTracks userTracks
     LEFT JOIN Hrs_WorkingProfiles workingProfiles
         ON @WorkingProfileID = workingProfiles.WorkingProfileID
     LEFT JOIN Hrs_WorkingProfileTypes workingProfileTypes
         ON workingProfiles.WorkingProfileTypeID = workingProfileTypes.WorkingProfileTypeID
     LEFT JOIN Hrs_WorkingCalendars workingCalendars
         ON workingProfileTypes.WorkingCalendarID = workingCalendars.WorkingCalendarID
     LEFT JOIN Hrs_CalendarDays calendarDays
         ON workingCalendars.WorkingCalendarID = calendarDays.WorkingCalendarID 
         AND userTracks.Date = calendarDays.Date
     WHERE userTracks.EmployeeNumber = @EmployeeNumber 
     AND userTracks.IsLock = 0 
     AND userTracks.Date = @Date ORDER BY userTracks.Time1";

