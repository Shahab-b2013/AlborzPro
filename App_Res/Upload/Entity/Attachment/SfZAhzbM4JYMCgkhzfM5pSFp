                        insertCommand.Parameters.Add("@EmployeeNumber", SqlDbType.Int).Value = employeeNumber;
                        insertCommand.Parameters.Add("@Date", SqlDbType.Date).Value = date;
                        insertCommand.Parameters.Add("@Description", SqlDbType.NVarChar).Value = description;

