                                     WHERE Date = @Date AND EmployeeNumber = @EmployeeNumber AND IsLock = 0 
                                     ORDER BY Time1";
                    List<int> timeRecords = new List<int>();

                    string insertManualTrackQuery = @"INSERT INTO Hrs_ManualTracks 
                                (TrackType, Time, EmployeeNumber, Date, Description, IsLock , IsCalculated) 
                                VALUES (@TrackType, @Time, @EmployeeNumber, @Date, @Description, 0 , 0)";

                    using (var selectCommand = new SqlCommand(selectQuery, conn, transaction))
