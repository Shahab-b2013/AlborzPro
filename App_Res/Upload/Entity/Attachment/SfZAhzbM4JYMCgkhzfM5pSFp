                    {

                        while (reader.Read())
                        {
                            bool isHoliday = reader.IsDBNull(reader.GetOrdinal("IsHoliday"))
                            ? false
                            : reader.GetBoolean(reader.GetOrdinal("IsHoliday"));
                            long userTrackID = 0;
