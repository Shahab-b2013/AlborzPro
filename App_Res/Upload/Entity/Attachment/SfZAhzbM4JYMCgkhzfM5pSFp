    [WebMethod(EnableSession = true)]
    public string AddNewTrackForAbsence(string date, int time1, int time2, string trackType, string description, string workLocation, int employeeId, string locationCity)
    {
        DateTime entryDate = DateTime.Parse(date);
        PersianCalendar persianCalendar = new PersianCalendar();
        int year = persianCalendar.GetYear(entryDate);
        int month = persianCalendar.GetMonth(entryDate);
        string dayName = GetPersianNameDayOfWeek(persianCalendar.GetDayOfWeek(entryDate));
        string resultMessage = "";

        object employeeNumber = employeeId == 0 ?
                    SqlDataProvider.ExecuteScalarQuery("(SELECT EmployeeNumber FROM Hrs_Employees WHERE EmployeeID=" + SessionProvider.UserID + ")") : employeeId;

        object result = SqlDataProvider.ExecuteScalarQuery
          ("SELECT _CreateDate FROM Hrs_DailyWorkingTimes WHERE Date='" + date + "' AND EmployeeID = " + employeeNumber).ToString();

        DateTime dailyDate;
        if (result == null || string.IsNullOrWhiteSpace(result.ToString()))
        {
            dailyDate = DateTime.Now;
        }
        else
        {
            dailyDate = DateTime.Parse(result.ToString());
        }

        if (!CheckValidEditDate(dailyDate, deadline))
            return invalidDateError;

        if (!UserIsMaster() && !UserIsTrackOwner(0))
            return accessDeneidError;

        if (!CheckExistsTrack(Convert.ToInt32(employeeNumber), date, time1, time2) && editMode == 0)
        {
            return invalidTimeNewTrack;
        }

        string[] validTrackTypes = { "PaidLeave", "OutOfficeWork", "MissionWork", "Telework" ,
            "StudentLeave","StudentOverTime","StudentTelework","UnPaidLeave", "AuthorizedAbsence",
        };

        int countTrackExist = Convert.ToInt32(SqlDataProvider.ExecuteScalarQuery("SELECT Count(*) FROM Hrs_UserTracks WHERE Date= '" + date
            + "' AND EmployeeNumber = " + employeeNumber + " AND TrackType = 'Exit' AND _IsDeleted = 0").ToString());
        string issueTypeDate = SqlDataProvider.ExecuteScalarQuery("SELECT IssueTypes FROM Hrs_DailyWorkingTimes WHERE Date = '" + date + "' AND EmployeeID = " + employeeNumber).ToString();

        if (!validTrackTypes.Contains(trackType) || time1 < 0 || time1 > 1439 || time2 < 0 ||
            time2 > 1439 || time2 <= time1 || (countTrackExist != 0 && editMode == 0)
            //|| issueTypeDate != "UnauthorizedAbsence"
            )
        {
            return invalidData;
        }

        object workingProfileID = SqlDataProvider.ExecuteScalarQuery(
         "SELECT WorkingProfileID FROM Hrs_Employees WHERE EmployeeNumber = " + employeeNumber);

        int workingProfileIDValue = int.Parse(workingProfileID.ToString());
        int startTimeWork = 0;
        int endTimeWork = 0;
        int startFloatingTimeWork = 0;
        int delayAllowedTime = 0;
        int endFloatingTimeWork = 0;
        int hurryAllowedTime = 0;

        using (SqlConnection connection = SqlDataProvider.DbConnection)
        {
            connection.Open();
            startTimeWork = GetTimeSpanValue(connection, workingProfileIDValue, 44);
            endTimeWork = GetTimeSpanValue(connection, workingProfileIDValue, 45);
            delayAllowedTime = GetIntValue(connection, workingProfileIDValue, 39);
            hurryAllowedTime = GetIntValue(connection, workingProfileIDValue, 40);
            startFloatingTimeWork = FetchFloatinTimeWork(connection, 47, workingProfileIDValue);
            endFloatingTimeWork = FetchFloatinTimeWork(connection, 46, workingProfileIDValue);
        }

        if (time1 > endTimeWork)
        {
            return invalidData;
        }
        int endTimeWorkNormal = endTimeWork;

        if (trackType == "PaidLeave" || trackType == "UnPaidLeave" || trackType == "StudentLeave"
            || trackType == "SickLeave" || trackType == "Telework" || trackType == "StudentOverTime"
            || trackType == "StudentTelework" || trackType == "AuthorizedAbsence")
        {
            time1 = startTimeWork;
            time2 = endTimeWork - endFloatingTimeWork;
        }

        //اگر مرخصی بود
        if (trackType == "PaidLeave" && !CheckLeaveBalance(entryDate, time1, time2, Convert.ToInt32(employeeNumber)))
            return invalidLeaveBalanceError;//مانده مرخصی شما برای ثبت مرخصی اسحقاقی کافی نمی باشد

        //اگر دورکاری بود
        if (trackType == "Telework" && !CheckTeleworkAccess(entryDate, Convert.ToInt32(employeeNumber)))
            return invalidTeleworkAccessError;//شما در این تاریخ دارای مجوز دورکاری نیستید

        if ((trackType == "MissionWork" || trackType == "OutOfficeWork") && !CheckMissionParameter(Convert.ToInt32(employeeNumber), trackType))
        {
            return invalidMissionPermission;
        }

        if (trackType == "StudentLeave" || trackType == "StudentOverTime" || trackType == "StudentTelework")
        {
            int countStudentLeave = Convert.ToInt32(SqlDataProvider.ExecuteScalarQuery
            (@"SELECT COUNT(*) 
                FROM Viw_Hrs_Student_Leaves
                WHERE EmployeeNumber = " + employeeNumber + @"
                AND '" + date + @"' >= StartDate
                AND '" + date + @"' <= EndDate
                AND Day = N'" + dayName + @"'
                  AND DATEDIFF(MINUTE, StartTime, EndTime) >= 360").ToString());

            if (countStudentLeave == 0)
            {
                return invalidData;
            }
            else
            {
                string leaveTypeStudentAmends = SqlDataProvider.ExecuteScalarQuery
                ("SELECT TOP 1 Amends FROM Viw_Hrs_Student_Leaves WHERE EmployeeNumber = " + employeeNumber +
                " AND '" + date + "' >= StartDate AND '" + date + "' <= EndDate AND Day = N'" + dayName + "'").ToString();
                if (trackType == "StudentTelework")
                {
                    if (leaveTypeStudentAmends != "دورکاری")
                    {
                        return invalidData;
                    }
                }
                else if (trackType == "StudentOverTime")
                {
                    if (leaveTypeStudentAmends != "کار در روز تعطیل" && leaveTypeStudentAmends != "کار پس از ساعت اداری ")
