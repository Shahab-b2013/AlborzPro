            {
                try
                {
                    string insertTrackQuery = @"INSERT INTO Hrs_ManualTracks 
                                          (TrackType, Time, EmployeeNumber, Date,Description, IsLock , IsCalculated) 
                                          VALUES (@TrackType, @Time, @EmployeeNumber, @Date,@Description, 0 , 0)";
