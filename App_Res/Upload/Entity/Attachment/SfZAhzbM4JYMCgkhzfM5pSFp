                            trackStatus = "ManualTrack";
                        }
                        string trackTypeForIndex = validIndexCounter % 2 == 0 ? "Entry" : "Exit";

                        using (var insertUserTrackCommand = new SqlCommand(insertUserTracksQuery, conn, transaction))
                        {
                            insertUserTrackCommand.Parameters.Add("@TrackType", SqlDbType.NVarChar).Value = trackTypeForIndex;
