                hurryAllowedTime = GetIntValue(connection, workingProfileIDValue, 40);
                startFloatingTimeWork = FetchFloatinTimeWork(connection, 47, workingProfileIDValue);
                endFloatingTimeWork = FetchFloatinTimeWork(connection, 46, workingProfileIDValue);

