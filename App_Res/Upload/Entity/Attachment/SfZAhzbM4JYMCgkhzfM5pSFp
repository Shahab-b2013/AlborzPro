                                              (CASE WHEN CountIssues > 0 THEN  CountIssues - 1 ELSE CountIssues END) WHERE EmployeeID = @EmployeeID AND Month = @Month AND Year = @Year";

                        using (var updateMonthlyCommand = new SqlCommand(updateMonthlyIssue, conn, transaction))
