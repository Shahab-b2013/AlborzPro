                    }
                    string selectManualTracksQuery = @"SELECT Time , Description FROM Hrs_ManualTracks 
                                                 WHERE Date = @Date AND EmployeeNumber = @EmployeeNumber AND IsLock = 0 
                                                 ORDER BY Time";

                    List<ManualTrackDetail> manualTrackDetails = new List<ManualTrackDetail>();
                    using (var selectCommand = new SqlCommand(selectManualTracksQuery, conn, transaction))
                    {
                        selectCommand.Parameters.Add("@Date", SqlDbType.Date).Value = date;
                        selectCommand.Parameters.Add("@EmployeeNumber", SqlDbType.Int).Value = employeeNumber;

