                                {
                                    insertCommand.Parameters.Add("@TrackType", SqlDbType.NVarChar).Value = "Exit";
                                    insertCommand.Parameters.Add("@Time", SqlDbType.Int).Value = time2;
                                    insertCommand.Parameters.Add("@EmployeeNumber", SqlDbType.Int).Value = employeeNumber;
