                        if (manualTrackDetails[i].Time == manualTrackDetails[i + 1].Time)
                        {
                            continue;
                        }
                        string trackStatus = "";
                        if (!hasColor)
                        {
                            if (manualTrackDetails[i].Time == time)
                            {
                                trackStatus = "ManualTrack2";
                                hasColor = true;
                            }
                            else if (manualTrackDetails[i + 1].Time == time)
